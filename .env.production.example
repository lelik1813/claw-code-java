# ── Production Environment Template ──────────────────────────────────
# Copy to .env and fill all REQUIRED values before deploy.
# Run: ./scripts/phase8-smoke.ps1 -ApiKey <key> after deploy.

# ── REQUIRED ──────────────────────────────────────────────────────────

# Server
SERVER_PORT=8080

# Persistence
PERSISTENCE_BACKEND=r2dbc

# PostgreSQL
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=claw_code_java
POSTGRES_USER=claw_code_java
POSTGRES_PASSWORD=

# Anthropic
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_DEFAULT_SONNET_MODEL=deepseek-v4-flash

# Security — both MUST be enabled in production
APP_SECURITY_API_KEY_ENABLED=true
APP_SECURITY_API_KEY_HEADER=X-API-Key
APP_SECURITY_API_KEY_KEY=
APP_RATE_LIMIT_ENABLED=true
APP_RATE_LIMIT_REQUESTS=100
APP_RATE_LIMIT_WINDOW_SECONDS=60

# ── OPTIONAL — enable as needed ──────────────────────────────────────

# Tasks (disabled by default)
# APP_TASKS_ENABLED=true
# APP_TASKS_BACKEND=IN_MEMORY
# APP_TASKS_MAX_CONCURRENT=10
# APP_TASKS_DEFAULT_TIMEOUT_MS=300000

# Skills (disabled by default)
# APP_SKILLS_ENABLED=true
# APP_SKILLS_ROOT=/opt/claw-code-java/skills

# Plugins (disabled by default)
# APP_PLUGINS_ENABLED=true
# APP_PLUGINS_DIRS=/opt/claw-code-java/plugins

# Web tools (disabled by default)
# APP_WEB_TOOLS_ENABLED=true
# APP_WEB_TOOLS_SEARCH_BASE_URL=
# APP_WEB_TOOLS_SEARCH_API_KEY=

# Query runtime
# APP_QUERY_MAX_TOOL_ROUNDS=10

# Tool permission policy (optional hardening)
# APP_TOOLS_ENABLED=true
# APP_TOOLS_MODE=ALLOWLIST
# APP_TOOLS_ALLOWED=file_list,file_read,file_glob,file_search,file_write,powershell
# For read-only inspection workers, prefer:
# APP_TOOLS_ALLOWED=file_list,file_read,file_glob,file_search
# Optional extra absolute roots for file tools (comma-separated).
# Use absolute paths only.
# APP_TOOLS_ALLOWED_ROOTS=/opt/claw-code-java/data

# MCP (disabled by default)
# APP_MCP_ENABLED=true
# See application.yml for MCP server definition examples
