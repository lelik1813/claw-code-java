# --- Anthropic API ---
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
API_TIMEOUT_MS=3000000
ANTHROPIC_DEFAULT_SONNET_MODEL=deepseek-v4-flash

# --- Persistence backend: r2dbc | in-memory ---
PERSISTENCE_BACKEND=in-memory
# Optional Spring-style alias supported by bootstrap:
# app.persistence.backend=in-memory

# --- Query runtime ---
# Maximum model/tool follow-up rounds per turn.
APP_QUERY_MAX_TOOL_ROUNDS=10

# --- PostgreSQL (used when PERSISTENCE_BACKEND=r2dbc) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=claw_code_java
POSTGRES_USER=claw_code_java
POSTGRES_PASSWORD=

# --- Flyway (optional overrides, defaults to POSTGRES_USER/PASSWORD) ---
FLYWAY_ENABLED=true
# FLYWAY_USER=
# FLYWAY_PASSWORD=

# --- Tool permissions / file access ---
# APP_TOOLS_ENABLED=true
# APP_TOOLS_MODE=ALLOWLIST
# APP_TOOLS_ALLOWED=file_list,file_read,file_glob,file_search,file_write,powershell
# Safe read-only live-test set:
# APP_TOOLS_ALLOWED=file_list,file_read,file_glob,file_search
# Optional extra absolute roots (comma-separated) for file tools.
# Paths under current workspace are always allowed without this setting.
# Example:
# APP_TOOLS_ALLOWED_ROOTS=
# APP_TOOLS_ALLOWED_ROOTS=

# --- API security / rate-limit (optional for local dev) ---
# APP_SECURITY_API_KEY_ENABLED=false
# APP_SECURITY_API_KEY_HEADER=X-API-Key
# APP_SECURITY_API_KEY_KEY=
# APP_RATE_LIMIT_ENABLED=false
# APP_RATE_LIMIT_REQUESTS=100
# APP_RATE_LIMIT_WINDOW_SECONDS=60

# --- Web tools (web_search / web_fetch) ---
APP_WEB_TOOLS_ENABLED=false
APP_WEB_TOOLS_SEARCH_ENABLED=true
APP_WEB_TOOLS_FETCH_ENABLED=true
APP_WEB_TOOLS_TIMEOUT_MS=30000
APP_WEB_TOOLS_MAX_RESPONSE_BYTES=1048576
APP_WEB_TOOLS_MAX_TEXT_CHARS=50000
APP_WEB_TOOLS_SEARCH_BASE_URL=
APP_WEB_TOOLS_SEARCH_API_KEY=
# APP_WEB_TOOLS_ALLOWED_SCHEMES=http,https
# APP_WEB_TOOLS_BLOCKED_HOSTS=

# --- CLI thin client ---
APP_CLI_BASE_URL=http://localhost:8080
APP_CLI_API_KEY_HEADER=X-API-Key
APP_CLI_API_KEY=
APP_CLI_TIMEOUT_MS=30000
APP_CLI_STREAM_READ_TIMEOUT_MS=300000
